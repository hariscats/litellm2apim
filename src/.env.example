# LiteLLM to Azure API Management Configuration
# Copy this file to .env and fill in your values

# Your APIM gateway endpoint (without trailing slash)
# Example: https://your-apim-instance.azure-api.net
APIM_ENDPOINT=https://your-apim-instance.azure-api.net

# Your APIM subscription key
APIM_SUBSCRIPTION_KEY=123456789abcdef123456789abcdef0

# Azure OpenAI deployment name (the name you gave your GPT-4o deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview
